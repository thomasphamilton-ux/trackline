{
  "name": "trackline",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run",
    "test:rules": "firebase emulators:exec --only firestore --project demo-trackline \"vitest run --config vitest.rules.config.ts\"",
    "emulators": "firebase emulators:start --project demo-trackline"
  }
}
