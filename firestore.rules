rules_version = '2';

// Trackline security rules (v0.2, Phase 0).
// Data model:
//   /admins/{uid}                          - doc exists => that user is a global Admin
//   /projects/{projectId}                  - {name, createdAt}
//   /projects/{projectId}/assets/{assetId} - asset records; stages is a map keyed by stage name
//   /members/{projectId}_{uid}             - {projectId, userId, userName, role, addedAt}
//                                             role: "Supervisor" | "Contractor" | "Viewer"
//                                             (Admin is global, via /admins)
//   /accessRequests/{projectId}_{uid}      - {projectId, userId, userName, requestedAt}
//   /mustChangePassword/{uid}              - written only by the resetUserPassword function
//   /users/{uid}                           - {name, phone}, self-editable
//   /disabledAccounts/{uid}                - written only by the setAccountDisabled function
//
// Roles:
//   Admin       everything, all projects
//   Supervisor  manage assets, identifiers, users (not Admins) in their project
//   Contractor  update progress and details; cannot change INT FOD, FTE, turnover,
//               linked codes, or add/remove seals
//   Viewer      read-only (built now for future use)
//
// "Unassigned" assets live under /projects/_unassigned/assets and are visible to Admins only.

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function memberPath(projectId) {
      return /databases/$(database)/documents/members/$(projectId + '_' + request.auth.uid);
    }

    function isMember(projectId) {
      return signedIn() && exists(memberPath(projectId));
    }

    function myRole(projectId) {
      return isAdmin() ? 'Admin' : get(memberPath(projectId)).data.role;
    }

    function hasProjectAccess(projectId) {
      return isAdmin() || isMember(projectId);
    }

    function isLead(projectId) {
      return isAdmin() || (isMember(projectId) && myRole(projectId) in ['Supervisor']);
    }

    function isContractor(projectId) {
      return !isAdmin() && isMember(projectId) && myRole(projectId) == 'Contractor';
    }

    // Fields a Contractor may change on an asset.
    function contractorEditableKeys() {
      return ['stages', 'label', 'location', 'level', 'optiNum', 'seals', 'updatedAt', 'updatedBy'];
    }

    // Stages only Admins and Supervisors may change. Keep in sync with
    // DEFAULT_SEQUENCE in src/domain/stages.ts.
    function restrictedStagesUnchanged() {
      return request.resource.data.stages['INT FOD'] == resource.data.stages['INT FOD']
        && request.resource.data.stages['FTE'] == resource.data.stages['FTE'];
    }

    function contractorUpdateOk() {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      return changed.hasOnly(contractorEditableKeys())
        && (!('stages' in changed) || restrictedStagesUnchanged())
        // Contractors may edit seal notes but not add or remove seals.
        && (!('seals' in changed) || request.resource.data.seals.size() == resource.data.seals.size())
        && request.resource.data.updatedBy == request.auth.uid;
    }

    function validAsset(projectId) {
      let d = request.resource.data;
      return d.stages is map
        && d.projectId == (projectId == '_unassigned' ? '' : projectId);
    }

    // ---- projects ----
    match /projects/{projectId} {
      // Anyone signed in can read project names (needed for the "request access" list).
      allow read: if signedIn();
      allow create, update, delete: if isAdmin();

      match /assets/{assetId} {
        allow read: if hasProjectAccess(projectId);
        allow create: if isLead(projectId) && validAsset(projectId);
        allow update: if validAsset(projectId)
          && (isLead(projectId) || (isContractor(projectId) && contractorUpdateOk()));
        allow delete: if isLead(projectId);
      }
    }

    // ---- global admins ----
    match /admins/{uid} {
      allow read: if signedIn();
      // The very first Admin is bootstrapped manually in the Firebase console (SETUP.md).
      allow write: if isAdmin();
    }

    // ---- project members ----
    match /members/{memberId} {
      allow read: if signedIn();
      // memberId must be "{projectId}_{uid}". Admins add anyone; Supervisors of that
      // project add Supervisors, Contractors and Viewers.
      allow create: if signedIn()
        && memberId == request.resource.data.projectId + '_' + request.resource.data.userId
        && request.resource.data.role in ['Supervisor', 'Contractor', 'Viewer']
        && isLead(request.resource.data.projectId);
      allow delete: if signedIn()
        && memberId == resource.data.projectId + '_' + resource.data.userId
        && isLead(resource.data.projectId);
      allow update: if false; // remove + re-add instead of editing a role in place
    }

    // ---- access requests ----
    match /accessRequests/{reqId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && reqId == request.resource.data.projectId + '_' + request.auth.uid
        && request.resource.data.userId == request.auth.uid;
      allow delete: if signedIn()
        && (reqId == resource.data.projectId + '_' + request.auth.uid || isLead(resource.data.projectId));
    }

    // ---- forced password change flag ----
    match /mustChangePassword/{uid} {
      allow read, delete: if signedIn() && request.auth.uid == uid;
      allow create, update: if false;
    }

    // ---- user profiles ----
    match /users/{uid} {
      allow read: if signedIn();
      allow write: if signedIn() && request.auth.uid == uid;
    }

    // ---- disabled accounts ----
    match /disabledAccounts/{uid} {
      allow read: if signedIn();
      allow write: if false;
    }
  }
}
